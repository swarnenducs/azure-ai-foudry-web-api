# Local development only — copy to .env and fill in your values.
# On Azure App Service, use Application Settings instead (LOAD_DOTENV is off automatically).

ENVIRONMENT=development
LOG_LEVEL=INFO

# Azure auth: auto (default) uses DefaultAzureCredential locally, Managed Identity on Azure.
# Force locally: AZURE_CREDENTIAL_MODE=default
# Force managed identity: AZURE_CREDENTIAL_MODE=managed
# AZURE_CREDENTIAL_MODE=auto

# Required — Azure AI Foundry
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-project-endpoint>
AGENT_NAME=<your-foundry-agent-name>
AGENT_VERSION=1

# Optional API protection
# API_KEY=your-local-dev-key

# Fabric Data Agent routing
AGENT_REGISTRY_PATH=config/agent_registry.yaml
# FABRIC_ROUTING_MODE=rule
# FABRIC_QUERY_TIMEOUT=120

# Shared Azure OpenAI — used for llm/hybrid routing and for extracting structure
# when Fabric returns plain text instead of JSON (not used when Fabric sends JSON).
# LLM_ENDPOINT=https://<your-azure-openai-resource>.openai.azure.com
# LLM_DEPLOYMENT=gpt-4o-mini
# LLM_API_VERSION=2024-10-21

# Legacy names still supported: ROUTING_LLM_* / FABRIC_FORMATTER_LLM_*

# Legacy single-agent fallback (if agent_registry.yaml is missing)
# FABRIC_DATA_AGENT_URL=https://<fabric-workspace>/.../openai

# Force .env on/off locally (optional)
# LOAD_DOTENV=true
